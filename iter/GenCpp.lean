import Iter
/-! Prints `gen/proved_gen.hpp`: the C++ for `Iter.Gen.opt 8 wordPipe` and `Iter.Gen.recPipe`, proved
equal to their chains by `Iter.Gen.wordPipe_gen`, `Iter.Gen.wordPipe_count`, `Iter.Gen.wordPipe_max`, `Iter.Gen.wordPipe_nodiv*`, `Iter.Gen.recPipe_gen`, `Iter.Gen.recPipe_adapt`, `Iter.Gen.q6_gen`, `Iter.Gen.q6_adapt` and `Iter.Gen.findPipe_gen`. `replay.sh` checks the committed header is what this prints. -/
open Iter.Gen

def main : IO Unit := do
  IO.print ("// Generated by iter/GenCpp.lean from Iter.Gen.wordPipe; do not edit.\n" ++
    "// Iter.Gen.wordPipe_gen proves the loop equal to the Iter chain; the printer is trusted.\n" ++
    "#pragma once\n#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <optional>\n#include <utility>\n#include <vector>\n\n" ++
    "// Candidate loops, all proved equal (opt_correct / printed_correct hold for every lane count, and the branchy\n" ++
    "// step is the same acc[l] += sel keep body); the includer times them and keeps the fastest (speed only).\n" ++
    "struct WordCand { const char* tag; std::uint64_t (*f)(const std::vector<std::uint64_t>&, std::uint64_t); };\n\n" ++
    cands "provedU" wordPipe ++ "\n\n" ++
    "// Iter.Gen.wordPipe_count proves these loops equal to filter -> count.\n" ++
    cands "provedC" wordPipe.countPipe ++ "\n\n" ++
    "// Iter.Gen.wordPipe_max and wordPipe_nodiv_max prove these loops equal to filter -> map -> max?.\n" ++
    "struct RedCand { const char* tag; std::optional<std::uint64_t> (*f)(const std::vector<std::uint64_t>&, std::uint64_t); };\n\n" ++
    wordPipe.toCppRed .max 4 "provedMax_m4" ++ "\n\n" ++ wordPipe.nodiv.toCppRed .max 4 "provedMax_dm4" ++ "\n\n" ++
    wordPipe.nodiv.toCppRed .max 1 "provedMax_dm1" ++ "\n\n" ++
    "static const RedCand provedMax_cands[] = {{\"m4\", &provedMax_m4}, {\"dm4\", &provedMax_dm4}, {\"dm1\", &provedMax_dm1}};\n\n" ++
    "// Iter.Gen.recPipe_gen proves this loop equal to the running summary; needs Emp and Summ from the includer.\n" ++
    recPipe.toCpp 2 "provedA" "Emp" fs ++ "\n\n" ++
    "// Iter.Gen.recPipe_adapt proves this loop equal to the running summary for every masked/branchy choice.\n" ++
    recPipe.toCppAdapt 2 "adaptA" "Emp" fs 256 32 16 ++ "\n\n" ++
    "// TPC-H Query 6. Iter.Gen.q6_gen and Iter.Gen.q6_adapt prove these loops equal to the running summary\n" ++
    "// (Iter.Gen.q6_total: its total is the query's revenue); needs Line from the includer.\n" ++
    q6Pipe.toCpp 5 "provedQ6" "Line" q6fs ++ "\n\n" ++ q6Pipe.toCppAdapt 5 "adaptQ6" "Line" q6fs 256 32 16 ++ "\n\n" ++
    "struct Q6Cand { const char* tag; Summ (*f)(const std::vector<Line>&, std::uint64_t, std::uint64_t, std::uint64_t, std::uint64_t, std::uint64_t); };\n" ++
    "static const Q6Cand provedQ6_cands[] = {{\"masked\", &provedQ6}, {\"adapt\", &adaptQ6}};\n\n" ++
    "// Iter.Gen.findPipe_gen proves both loops equal to enumerate -> find? (x > k), for every block size.\n" ++
    findToCpp findPipe 0 "provedF_plain" ++ "\n\n" ++ findToCpp findPipe 32 "provedF_blocks" ++ "\n\n" ++
    "struct FindCand { const char* tag; std::optional<std::pair<std::size_t, std::uint64_t>> (*f)(const std::vector<std::uint64_t>&, std::uint64_t); };\n" ++
    "static const FindCand provedF_cands[] = {{\"plain\", &provedF_plain}, {\"blocks\", &provedF_blocks}};\n\n" ++
    "// Result chains (Iter/Res.lean). Iter.Res.checkChain_gen proves this function computes the and_then chain\n" ++
    "// Iter.Res.check; ok = 1 carries the value, ok = 0 the error code.\n" ++
    "struct Res { std::uint64_t ok, val; };\n" ++ Iter.Res.check.toCpp "provedCheck" ++ "\n")
where
  fs := ["e.salary", "(std::uint64_t)e.active"]
  q6fs := ["e.date", "e.disc", "e.qty", "e.price"]
  cands (base : String) (q : Pipe) : String :=
    let cs := [false, true].flatMap fun d => [1, 2, 4, 8].flatMap fun l => [(d, false, l), (d, true, l)]
    let pd := fun (d : Bool) => if d then "d" else ""
    let tag := fun (d b : Bool) (l : Nat) => s!"{pd d}{if b then "b" else "m"}{l}"
    let qq := fun (d : Bool) => if d then q.nodiv else q
    let tags := cs.map (fun (d, b, l) => tag d b l) ++ ["rb", "rm", "drb", "drm"]
    "\n\n".intercalate (cs.map fun (d, b, l) => (opt l (qq d)).toCpp s!"{base}_{tag d b l}" b) ++ "\n\n" ++
      "\n\n".intercalate ([false, true].map fun d =>
        (opt 1 (qq d)).toCppRange s!"{base}_{pd d}rb" ++ "\n\n" ++ (opt 1 (qq d)).toCppRange s!"{base}_{pd d}rm" false) ++ "\n\n" ++
      s!"static const WordCand {base}_cands[] = \{{", ".intercalate (tags.map fun t => s!"\{\"{t}\", &{base}_{t}}")}};"
