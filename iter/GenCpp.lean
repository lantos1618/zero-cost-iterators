import Iter
/-! Prints `gen/proved_gen.hpp`: the C++ for `Iter.Gen.opt 8 wordPipe`, proved equal to its chain by
`Iter.Gen.wordPipe_gen`. `replay.sh` checks the committed header is what this prints. -/
open Iter.Gen

def main : IO Unit := do
  IO.print ("// Generated by iter/GenCpp.lean from Iter.Gen.wordPipe; do not edit.\n" ++
    "// Iter.Gen.wordPipe_gen proves the loop equal to the Iter chain; the printer is trusted.\n" ++
    "#pragma once\n#include <cstddef>\n#include <cstdint>\n#include <vector>\n\n" ++
    (opt 8 wordPipe).toCpp "provedU" ++ "\n")
