import Pipe.Core
/-! Emitter (TRUSTED text printer, re-checked by the exact gate): lowered program → i8dot.c, prog.bend.
Each loop line is the checker-table line whose parse is exactly the op's rendered C statement. -/
open IR C Check

namespace Pipe

def lineOf (s : S) : Option String :=
  tableLines.find? fun l => match lineItem l with
    | some (.stmt t) => decide (t.toS = some s)
    | _ => false

def opLines (o : Op) : Option (List String) := do
  let ss ← opS o
  mapO lineOf ss

def emitC (label : String) (r : Reduced) : Option String := do
  let ls ← mapO opLines r.body
  let L := [s!"/* emitted by pipegen from chain {label} -- do not edit */",
    "#include <stddef.h>", "#include <stdint.h>", s!"#define I8DOT_MAX_N {r.guard}u", "",
    "int i8dot(const int8_t *a, const int8_t *b, size_t n, int32_t *out) {",
    "  if (n > I8DOT_MAX_N) return -1;",
    "  int32_t acc = 0;", "  int32_t r0 = 0;", "  int32_t r1 = 0;",
    "  for (size_t i = 0; i < n; i++) {"] ++ (ls.flatten.map ("    " ++ ·)) ++
    ["  }", "  *out = acc;", "  return 0;", "}", ""]
  pure ("\n".intercalate L)

def emitBend (label : String) (r : Reduced) : String :=
  s!"import Base\nimport ./kernel.bend as K\n\n# generated by pipegen from chain {label} -- do not edit\ndef prog() -> K.Stmts:\n  {BendP.showProg (lower r)}\n"

end Pipe
