import Bridge.BendKernel
import Bridge.BendProgs
import Bridge.Proofs
/-! r5: all-input link between the MECHANICALLY TRANSLATED Bend evaluator (`BK.*`, generated by
bendlink/bend2lean.py from the actual kernel.bend + the pinned base.bend whitelist) and the Lean IR model
used by `Proofs.gate_total`, through the Z{p,n} ↦ p − n decoding. -/
open C IR Check

namespace Link

/-! ### base.bend Nat/Cmp primitives (translated) = Lean Nat operations -/
theorem nat_add (a b : Nat) : BK.Nat_add a b = a + b := by
  induction a with
  | zero => simp [BK.Nat_add]
  | succ p ih => simp [BK.Nat_add, ih]; omega

theorem nat_sub (a b : Nat) : BK.Nat_sub a b = a - b := by
  induction a generalizing b with
  | zero => simp [BK.Nat_sub]
  | succ p ih =>
    cases b with
    | zero => simp [BK.Nat_sub]
    | succ q => simp [BK.Nat_sub, ih]

theorem nat_mul (a b : Nat) : BK.Nat_mul a b = a * b := by
  induction a with
  | zero => simp [BK.Nat_mul]
  | succ p ih => simp [BK.Nat_mul, ih, nat_add, Nat.succ_mul]; omega

theorem divmod_go (bp : Nat) : ∀ (n m d r : Nat), r + m = bp →
    BK.Nat_divmod_go n m d r = (d + (n + r) / (bp + 1), (n + r) % (bp + 1))
  | 0, m, d, r, h => by
    simp only [BK.Nat_divmod_go, Nat.zero_add]
    rw [Nat.div_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)]; simp
  | n + 1, 0, d, r, h => by
    simp only [BK.Nat_divmod_go]
    rw [divmod_go bp n r (d + 1) 0 (by omega)]; simp only [Nat.add_zero]
    have e : n + 1 + r = n + (bp + 1) := by omega
    rw [e, Nat.add_div_right _ (by omega), Nat.add_mod_right]
    simp only [Prod.mk.injEq, and_true]; omega
  | n + 1, m + 1, d, r, h => by
    simp only [BK.Nat_divmod_go]
    rw [divmod_go bp n m d (r + 1) (by omega)]
    have e : n + (r + 1) = n + 1 + r := by omega
    rw [e]

theorem nat_mod (a b : Nat) : BK.Nat_mod a b = a % b := by
  cases b with
  | zero => simp [BK.Nat_mod, BK.Nat_divmod, BK.Pair_snd]
  | succ bp => simp [BK.Nat_mod, BK.Nat_divmod, BK.Pair_snd, divmod_go bp a bp 0 0 (by omega)]

theorem cmp_spec : ∀ a b : Nat,
    BK.Nat_cmp a b = if a < b then BK.Cmp.LT else if a = b then BK.Cmp.EQ else BK.Cmp.GT
  | 0, 0 => rfl
  | 0, b + 1 => by simp [BK.Nat_cmp]
  | a + 1, 0 => by simp [BK.Nat_cmp]
  | a + 1, b + 1 => by simp [BK.Nat_cmp, cmp_spec a b]

theorem is_lt (a b : Nat) : BK.Nat_is_lt a b = decide (a < b) := by
  unfold BK.Nat_is_lt; rw [cmp_spec]
  by_cases h1 : a < b <;> by_cases h2 : a = b <;> simp [h1, h2, BK.Cmp_is_lt]

theorem is_eq (a b : Nat) : BK.Nat_is_eq a b = decide (a = b) := by
  unfold BK.Nat_is_eq; rw [cmp_spec]
  by_cases h1 : a < b <;> by_cases h2 : a = b <;> simp [h1, h2, BK.Cmp_is_eq] <;> omega

theorem is_le (a b : Nat) : BK.Nat_is_le a b = decide (a ≤ b) := by
  unfold BK.Nat_is_le; rw [cmp_spec]
  by_cases h1 : a < b <;> by_cases h2 : a = b <;> simp [h1, h2, BK.Cmp_is_le] <;> omega

/-! ### decoding: Z{p,n} ↦ p − n, and the IR/state structure -/
def zv : BK.Z → Int | .Z p n => (p : Int) - n
def zsv : BK.Zs → List Int | .ZNil => [] | .ZCons h t => zv h :: zsv t
def opv : BK.Op → IR.Op
  | .LdA => .LdA | .LdB => .LdB | .Mul => .Mul | .Acc => .Acc | .Wrap => .Wrap | .StT => .StT | .LdT => .LdT
  | .Sub => .Sub | .Abs => .Abs | .Sq => .Sq | .Pos => .Pos | .Bit => .Bit | .AbsT => .AbsT | .Ne0 => .Ne0
def opsv : BK.Ops → List IR.Op | .ONil => [] | .OCons h t => opv h :: opsv t
def stmtv : BK.Stmt → IR.PS | .Alloc => .Alloc | .Loop b => .Loop (opsv b)
def stmtsv : BK.Stmts → IR.Prog | .PNil => [] | .PCons h t => stmtv h :: stmtsv t
def stv : BK.St → IR.St | .St r0 r1 acc mats tout => ⟨zv r0, zv r1, zv acc, mats, zsv tout⟩

theorem zadd_v (a b : BK.Z) : zv (BK.zadd a b) = zv a + zv b := by
  cases a; cases b; simp only [BK.zadd, zv, nat_add, Int.natCast_add]; omega

theorem zmul_v (a b : BK.Z) : zv (BK.zmul a b) = zv a * zv b := by
  cases a with
  | Z p n =>
    cases b with
    | Z q m =>
      simp only [BK.zmul, zv, nat_add, nat_mul, Int.natCast_add, Int.natCast_mul, Int.sub_mul, Int.mul_sub]
      omega

theorem zsub_v (a b : BK.Z) : zv (BK.zsub a b) = zv a - zv b := by
  cases a; cases b; simp only [BK.zsub, zv, nat_add, Int.natCast_add]; omega

theorem zabs_v (a : BK.Z) : zv (BK.zabs a) = if zv a < 0 then -zv a else zv a := by
  cases a with
  | Z p n =>
    show zv (BK.zabs_sel p n (BK.Nat_is_le n p)) = _
    rw [is_le]; unfold BK.zabs_sel
    by_cases h : n ≤ p
    · rw [show decide (n ≤ p) = true from decide_eq_true h]; dsimp only
      simp only [zv, nat_sub]; split <;> omega
    · rw [show decide (n ≤ p) = false from decide_eq_false h]; dsimp only
      simp only [zv, nat_sub]; split <;> omega

theorem zpos_v (a : BK.Z) : zv (BK.zpos a) = if zv a < 0 then 0 else zv a := by
  cases a with
  | Z p n => simp only [BK.zpos, zv, nat_sub]; split <;> omega

theorem zbit_v (a : BK.Z) : zv (BK.zbit a) = if zv a > 0 then 1 else zv a := by
  cases a with
  | Z p n =>
    show zv (BK.zbit_sel p n (BK.Nat_is_le p n)) = _
    rw [is_le]; unfold BK.zbit_sel
    by_cases h : p ≤ n
    · rw [show decide (p ≤ n) = true from decide_eq_true h]; dsimp only
      simp only [zv]; split <;> omega
    · rw [show decide (p ≤ n) = false from decide_eq_false h]; dsimp only
      simp only [zv]; split <;> omega

theorem zne0_v (a : BK.Z) : zv (BK.zne0 a) = if zv a = 0 then 0 else 1 := by
  cases a with
  | Z p n =>
    show zv (BK.zne0_sel p n (BK.Nat_is_le p n)) = _
    rw [is_le]; unfold BK.zne0_sel
    by_cases h : p ≤ n
    · rw [show decide (p ≤ n) = true from decide_eq_true h]; dsimp only
      rw [is_le]; unfold BK.zne0_eq
      by_cases h2 : n ≤ p
      · rw [show decide (n ≤ p) = true from decide_eq_true h2]; dsimp only; simp only [zv]; split <;> omega
      · rw [show decide (n ≤ p) = false from decide_eq_false h2]; dsimp only; simp only [zv]; split <;> omega
    · rw [show decide (p ≤ n) = false from decide_eq_false h]; dsimp only
      simp only [zv]; split <;> omega

theorem w8_nat_v (r : Nat) (h : r < 256) :
    zv (BK.w8_nat r) = if r < 128 then (r : Int) else (r : Int) - 256 := by
  unfold BK.w8_nat; rw [is_lt]
  by_cases hr : r < 128
  · rw [show decide (r < 128) = true from decide_eq_true hr]; simp [BK.w8_pos, zv, hr]
  · rw [show decide (r < 128) = false from decide_eq_false hr]; simp [BK.w8_pos, zv, hr, nat_sub]; omega

theorem wrap8_v (a : BK.Z) : zv (BK.wrap8 a) = IR.wrap8 (zv a) := by
  cases a with
  | Z p n =>
    show zv (BK.w8_sel p n (BK.Nat_is_le n p)) = _
    rw [is_le]; unfold BK.w8_sel
    by_cases h : n ≤ p
    · rw [show decide (n ≤ p) = true from decide_eq_true h]; dsimp only
      rw [nat_mod, nat_sub, w8_nat_v _ (Nat.mod_lt _ (by decide))]
      simp only [zv, IR.wrap8]; split <;> omega
    · rw [show decide (n ≤ p) = false from decide_eq_false h]; dsimp only
      unfold BK.w8_negr BK.w8_neg; rw [is_eq, nat_mod, nat_sub]
      by_cases h0 : (n - p) % 256 = 0
      · rw [show decide ((n - p) % 256 = 0) = true from decide_eq_true h0]; dsimp only
        simp only [BK.z0, zv, IR.wrap8]; omega
      · rw [show decide ((n - p) % 256 = 0) = false from decide_eq_false h0]; dsimp only
        rw [nat_sub, w8_nat_v _ (by omega)]
        simp only [zv, IR.wrap8]; split <;> omega

theorem hd_v (l : BK.Zs) : zv (BK.hd l) = IR.hd (zsv l) := by
  cases l <;> simp [BK.hd, IR.hd, zsv, BK.z0, zv]
theorem tl_v (l : BK.Zs) : zsv (BK.tl l) = IR.tl (zsv l) := by
  cases l <;> simp [BK.tl, IR.tl, zsv]
theorem zsnoc_v (l : BK.Zs) (x : BK.Z) : zsv (BK.zsnoc l x) = zsv l ++ [zv x] := by
  induction l with
  | ZNil => simp [BK.zsnoc, zsv]
  | ZCons h t ih => simp [BK.zsnoc, zsv, ih]

theorem exec_v (op : BK.Op) (x y t : BK.Z) (st : BK.St) :
    stv (BK.exec op x y t st) = IR.exec (opv op) (zv x) (zv y) (zv t) (stv st) := by
  cases st with
  | St r0 r1 acc mats tout =>
    cases op <;> simp [BK.exec, IR.exec, stv, opv, zmul_v, zadd_v, zsub_v, zabs_v, zpos_v, zbit_v, zne0_v, wrap8_v, zsnoc_v, Nat.add_comm]

theorem exec_body_v (x y t : BK.Z) : ∀ (ops : BK.Ops) (st : BK.St),
    stv (BK.exec_body ops x y t st) = IR.execBody (opsv ops) (zv x) (zv y) (zv t) (stv st)
  | .ONil, st => by simp [BK.exec_body, IR.execBody, opsv]
  | .OCons h r, st => by simp [BK.exec_body, IR.execBody, opsv, exec_v, exec_body_v x y t r]

theorem run_loop_v (body : BK.Ops) : ∀ (xs ys tin : BK.Zs) (st : BK.St),
    stv (BK.run_loop body xs ys tin st) = IR.runLoop (opsv body) (zsv xs) (zsv ys) (zsv tin) (stv st)
  | .ZNil, ys, tin, st => by simp [BK.run_loop, IR.runLoop, zsv]
  | .ZCons x xt, .ZNil, tin, st => by simp [BK.run_loop, IR.runLoop, zsv]
  | .ZCons x xt, .ZCons y yt, tin, st => by
    simp [BK.run_loop, IR.runLoop, zsv, run_loop_v body xt yt, exec_body_v, hd_v, tl_v]

theorem start_v (body : BK.Ops) (xs ys : BK.Zs) (st : BK.St) :
    stv (BK.start body xs ys st) = IR.start (opsv body) (zsv xs) (zsv ys) (stv st) := by
  cases st with
  | St r0 r1 acc mats tout => simp only [BK.start]; rw [run_loop_v]; rfl

theorem run_prog_v (xs ys : BK.Zs) : ∀ (p : BK.Stmts) (st : BK.St),
    stv (BK.run_prog p xs ys st) = IR.runProg (stmtsv p) (zsv xs) (zsv ys) (stv st)
  | .PNil, st => by simp [BK.run_prog, IR.runProg, stmtsv]
  | .PCons .Alloc r, st => by
    cases st with
    | St r0 r1 acc mats tout =>
      simp only [BK.run_prog, BK.bump]; rw [run_prog_v xs ys r]
      simp only [stmtsv, stmtv, IR.runProg, stv, Nat.add_comm]
  | .PCons (.Loop b) r, st => by
    simp [BK.run_prog, IR.runProg, stmtsv, stmtv, run_prog_v xs ys r, start_v]

/-- FULL STATE CORRESPONDENCE, all programs and all inputs: decoding the translated Bend `run` gives
`IR.run` (registers, accumulator, materialization count, buffer contents) -/
theorem run_v (p : BK.Stmts) (xs ys : BK.Zs) :
    stv (BK.run p xs ys) = IR.run (stmtsv p) (zsv xs) (zsv ys) := by
  have hi : stv BK.init = IR.init := by simp [stv, BK.init, BK.z0, zv, zsv, IR.init]
  simp only [BK.run, IR.run]; rw [run_prog_v, hi]

theorem acc_of_v (st : BK.St) : zv (BK.acc_of st) = (stv st).acc := by cases st; rfl
theorem mats_of_v (st : BK.St) : BK.mats_of st = (stv st).mats := by cases st; rfl

theorem dot_v : ∀ (xs ys : BK.Zs) (acc : BK.Z), zv (BK.dot xs ys acc) = zv acc + refDot (zsv xs) (zsv ys)
  | .ZNil, ys, acc => by simp [BK.dot, refDot, zsv]
  | .ZCons x xt, .ZNil, acc => by simp [BK.dot, refDot, zsv]
  | .ZCons x xt, .ZCons y yt, acc => by
    simp [BK.dot, refDot, zsv, dot_v xt yt, zadd_v, zmul_v, Int.add_assoc]

/-- the translated prog.bend terms decode to the IR the checker certifies (definitional) -/
theorem prog_pos_v : stmtsv BK.P_pos.prog = posIR := rfl
theorem prog_wrap_v : stmtsv BK.P_wrap.prog = wrapIR := rfl
theorem prog_buf_v : stmtsv BK.P_buf.prog = bufIR := rfl
theorem prog_l1_v : stmtsv BK.P_l1.prog = l1IR := rfl
theorem prog_l2_v : stmtsv BK.P_l2.prog = l2IR := rfl
theorem prog_ham_v : stmtsv BK.P_ham.prog = hamIR := rfl
theorem prog_osl_v : stmtsv BK.P_osl.prog = oslIR := rfl

theorem hamd_v : ∀ (xs ys : BK.Zs) (acc : BK.Z), zv (BK.hamd xs ys acc) = zv acc + refHam (zsv xs) (zsv ys)
  | .ZNil, ys, acc => by simp [BK.hamd, refHam, zsv]
  | .ZCons x xt, .ZNil, acc => by simp [BK.hamd, refHam, zsv]
  | .ZCons x xt, .ZCons y yt, acc => by
    simp only [BK.hamd, refHam, zsv, hamd_v xt yt, zadd_v, zne0_v, zsub_v]
    (repeat' split) <;> omega

theorem posd_v : ∀ (xs ys : BK.Zs) (acc : BK.Z), zv (BK.posd xs ys acc) = zv acc + refOsl (zsv xs) (zsv ys)
  | .ZNil, ys, acc => by simp [BK.posd, refOsl, zsv]
  | .ZCons x xt, .ZNil, acc => by simp [BK.posd, refOsl, zsv]
  | .ZCons x xt, .ZCons y yt, acc => by
    simp only [BK.posd, refOsl, zsv, posd_v xt yt, zadd_v, zpos_v, zsub_v]
    by_cases hd : zv x - zv y < 0 <;> simp only [hd, ↓reduceIte] <;> (repeat' split) <;> omega

theorem sad_v : ∀ (xs ys : BK.Zs) (acc : BK.Z), zv (BK.sad xs ys acc) = zv acc + refL1 (zsv xs) (zsv ys)
  | .ZNil, ys, acc => by simp [BK.sad, refL1, zsv]
  | .ZCons x xt, .ZNil, acc => by simp [BK.sad, refL1, zsv]
  | .ZCons x xt, .ZCons y yt, acc => by
    simp only [BK.sad, refL1, zsv, sad_v xt yt, zadd_v, zabs_v, zsub_v]; omega

theorem ssd_v : ∀ (xs ys : BK.Zs) (acc : BK.Z), zv (BK.ssd xs ys acc) = zv acc + refL2 (zsv xs) (zsv ys)
  | .ZNil, ys, acc => by simp [BK.ssd, refL2, zsv]
  | .ZCons x xt, .ZNil, acc => by simp [BK.ssd, refL2, zsv]
  | .ZCons x xt, .ZCons y yt, acc => by
    simp only [BK.ssd, refL2, zsv, ssd_v xt yt, zadd_v, zmul_v, zsub_v]; omega

/-- the translated actual Bend evaluator on the actual l1/l2 prog.bend terms equals the independent
Bend references `sad` / `ssd` (decoded), for all inputs -/
theorem bend_l1_eq_sad (xs ys : BK.Zs) : zv (BK.acc_of (BK.run BK.P_l1.prog xs ys)) = zv (BK.sad xs ys BK.z0) := by
  rw [acc_of_v, run_v, prog_l1_v, Proofs.ir_exact_run l1IR (by decide), sad_v]
  simp [Proofs.refOf, BK.z0, zv, l1IR, l2IR, hamIR, oslIR]
theorem bend_l2_eq_ssd (xs ys : BK.Zs) : zv (BK.acc_of (BK.run BK.P_l2.prog xs ys)) = zv (BK.ssd xs ys BK.z0) := by
  rw [acc_of_v, run_v, prog_l2_v, Proofs.ir_exact_run l2IR (by decide), ssd_v]
  simp [Proofs.refOf, BK.z0, zv, l1IR, l2IR, hamIR, oslIR]
theorem bend_ham_eq_hamd (xs ys : BK.Zs) : zv (BK.acc_of (BK.run BK.P_ham.prog xs ys)) = zv (BK.hamd xs ys BK.z0) := by
  rw [acc_of_v, run_v, prog_ham_v, Proofs.ir_exact_run hamIR (by decide), hamd_v]
  simp [Proofs.refOf, BK.z0, zv, l1IR, l2IR, hamIR, oslIR]
theorem bend_osl_eq_posd (xs ys : BK.Zs) : zv (BK.acc_of (BK.run BK.P_osl.prog xs ys)) = zv (BK.posd xs ys BK.z0) := by
  rw [acc_of_v, run_v, prog_osl_v, Proofs.ir_exact_run oslIR (by decide), posd_v]
  simp [Proofs.refOf, BK.z0, zv, l1IR, l2IR, hamIR, oslIR]

/-- Lean re-proof, on the translation, of Bend LAW 1 as Z-structural equality (Bend checked the same law) -/
theorem run_loop_pos_acc : ∀ (xs ys tin : BK.Zs) (st : BK.St),
    BK.acc_of (BK.run_loop (.OCons .LdA (.OCons .LdB (.OCons .Mul (.OCons .Acc .ONil)))) xs ys tin st)
      = BK.dot xs ys (BK.acc_of st)
  | .ZNil, ys, tin, st => by simp [BK.run_loop, BK.dot]
  | .ZCons x xt, .ZNil, tin, st => by simp [BK.run_loop, BK.dot]
  | .ZCons x xt, .ZCons y yt, tin, st => by
    cases st with
    | St r0 r1 acc mats tout =>
      simp only [BK.run_loop, BK.dot, BK.exec_body, BK.exec]; rw [run_loop_pos_acc xt yt]; rfl

theorem bend_law_exact_on_translation (xs ys : BK.Zs) :
    BK.acc_of (BK.run BK.P_pos.prog xs ys) = BK.dot xs ys BK.z0 := by
  simp only [BK.run, BK.P_pos.prog, BK.run_prog, BK.start, BK.init]; rw [run_loop_pos_acc]; rfl

/-- Lean re-proof, on the translation, of Bend LAW 2 (no buffer op executed) for pos and wrap -/
theorem ir_loop_mats (ops : List IR.Op) (h : IR.Op.StT ∉ ops) : ∀ (xs ys tin : List Int) (s : IR.St),
    (IR.runLoop ops xs ys tin s).mats = s.mats := by
  have hb : ∀ (o : List IR.Op), IR.Op.StT ∉ o → ∀ x y t (s : IR.St), (IR.execBody o x y t s).mats = s.mats := by
    intro o; induction o with
    | nil => intros; rfl
    | cons a r ih =>
      intro hn x y t s
      simp only [List.mem_cons, not_or] at hn
      simp only [IR.execBody]; rw [ih hn.2]
      cases a <;> simp [IR.exec] at hn ⊢
  intro xs; induction xs with
  | nil => intros; simp [IR.runLoop]
  | cons x xt ih =>
    intro ys tin s; cases ys with
    | nil => simp [IR.runLoop]
    | cons y yt => simp only [IR.runLoop]; rw [ih, hb ops h]

theorem bend_law_nobuf_on_translation (xs ys : BK.Zs) :
    BK.mats_of (BK.run BK.P_pos.prog xs ys) = 0 ∧ BK.mats_of (BK.run BK.P_wrap.prog xs ys) = 0 := by
  rw [mats_of_v, mats_of_v, run_v, run_v, prog_pos_v, prog_wrap_v]
  constructor
  · simp [IR.run, IR.runProg, IR.start, posIR, IR.init]; exact ir_loop_mats _ (by decide) _ _ _ _
  · simp [IR.run, IR.runProg, IR.start, wrapIR, IR.init]; exact ir_loop_mats _ (by decide) _ _ _ _

/-- every finite Int list is the decoding of some Bend `Zs` (so the quantifiers below are not vacuous) -/
def enc (z : Int) : BK.Z := if 0 ≤ z then .Z z.toNat 0 else .Z 0 (-z).toNat
def encs : List Int → BK.Zs | [] => .ZNil | z :: r => .ZCons (enc z) (encs r)
theorem zsv_encs : ∀ l : List Int, zsv (encs l) = l
  | [] => rfl
  | z :: r => by
    simp only [encs, zsv, zsv_encs r, List.cons.injEq, and_true]
    unfold enc; split <;> simp [zv] <;> omega

/-- PUBLIC GUARANTEE, stated against the translated actual Bend evaluator: PASS of the same executable
gate ⇒ for any Bend program term `q` decoding to the certified IR `p`, any admitted input and any Bend
sequences `xs`, `ys` decoding to the first n elements of a, b: the C semantics returns -1 with *out
unchanged if n > bound p, and otherwise returns 0 with *out = p − n of `K.acc_of(K.run(q, xs, ys))`. -/
theorem gate_total_bend {cs bs : String} {ex : Bool} {p : Prog} (h : gate cs bs ex = .pass p) :
    ∃ f, C.parseFile cs = .ok f ∧ BendP.parseBend bs = .ok p ∧ certified p = true ∧
      (ex = true → exactCert p = true) ∧
      ∀ (q : BK.Stmts), stmtsv q = p → ∀ (env : Env) (out0 : Option Int) (xs ys : BK.Zs), Admitted env →
        zsv xs = env.a.take env.n → zsv ys = env.b.take env.n →
        cRun f env out0 = if bound p < env.n then .ret (-1) out0
          else .ret 0 (some (zv (BK.acc_of (BK.run q xs ys)))) := by
  obtain ⟨f, hf, hb, hc, hx, H⟩ := Proofs.gate_total h
  refine ⟨f, hf, hb, hc, hx, ?_⟩
  intro q hq env out0 xs ys ha hxs hys
  rw [H env out0 ha, acc_of_v, run_v, hq, hxs, hys]

/-- EXACT GATE against the actual translated prog.bend terms: PASS ⇒ prog.bend is (the translation of)
variants/pos, l1, l2, ham or osl, and the C result is the translated actual Bend evaluator on that term; by
`bend_law_exact_on_translation`, `bend_l1_eq_sad`, `bend_l2_eq_ssd`, `bend_ham_eq_hamd`, `bend_osl_eq_posd` that equals Bend's dot / sad / ssd / hamd / posd. -/
theorem exact_gate_bend {cs bs : String} {p : Prog} (h : gate cs bs true = .pass p) :
    ∃ f q, C.parseFile cs = .ok f ∧ (q = BK.P_pos.prog ∨ q = BK.P_l1.prog ∨ q = BK.P_l2.prog ∨
        q = BK.P_ham.prog ∨ q = BK.P_osl.prog) ∧
      BendP.parseBend bs = .ok (stmtsv q) ∧ ∀ (env : Env) (out0 : Option Int), Admitted env →
        cRun f env out0 = if bound p < env.n then .ret (-1) out0
          else .ret 0 (some (zv (BK.acc_of (BK.run q (encs (env.a.take env.n)) (encs (env.b.take env.n)))))) := by
  obtain ⟨f, hf, hb, -, hx, H⟩ := gate_total_bend h
  rcases Proofs.exactCert_cases (hx rfl) with rfl | rfl | rfl | rfl | rfl
  · exact ⟨f, _, hf, Or.inl rfl, by rw [prog_pos_v]; exact hb,
      fun env out0 ha => H _ prog_pos_v env out0 _ _ ha (zsv_encs _) (zsv_encs _)⟩
  · exact ⟨f, _, hf, by simp, by rw [prog_l1_v]; exact hb,
      fun env out0 ha => H _ prog_l1_v env out0 _ _ ha (zsv_encs _) (zsv_encs _)⟩
  · exact ⟨f, _, hf, by simp, by rw [prog_l2_v]; exact hb,
      fun env out0 ha => H _ prog_l2_v env out0 _ _ ha (zsv_encs _) (zsv_encs _)⟩
  · exact ⟨f, _, hf, by simp, by rw [prog_ham_v]; exact hb,
      fun env out0 ha => H _ prog_ham_v env out0 _ _ ha (zsv_encs _) (zsv_encs _)⟩
  · exact ⟨f, _, hf, by simp, by rw [prog_osl_v]; exact hb,
      fun env out0 ha => H _ prog_osl_v env out0 _ _ ha (zsv_encs _) (zsv_encs _)⟩

/-- match gate for wrap, instantiated with the translation of the actual variants/wrap/prog.bend term -/
theorem match_gate_bend_wrap {cs bs : String} {ex : Bool} {p : Prog} (h : gate cs bs ex = .pass p)
    (hw : BendP.parseBend bs = .ok (stmtsv BK.P_wrap.prog)) :
    ∃ f, C.parseFile cs = .ok f ∧ ∀ (env : Env) (out0 : Option Int) (xs ys : BK.Zs), Admitted env →
      zsv xs = env.a.take env.n → zsv ys = env.b.take env.n →
      cRun f env out0 = if 131071 < env.n then .ret (-1) out0
        else .ret 0 (some (zv (BK.acc_of (BK.run BK.P_wrap.prog xs ys)))) := by
  obtain ⟨f, hf, hb, -, -, H⟩ := gate_total_bend h
  rw [hw] at hb; cases hb
  refine ⟨f, hf, fun env out0 xs ys ha h1 h2 => ?_⟩
  have e := H BK.P_wrap.prog rfl env out0 xs ys ha h1 h2
  rwa [prog_wrap_v, show bound wrapIR = 131071 by decide] at e

end Link
